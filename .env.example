# Backend scripts load this root .env file. Never commit the actual .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://homefinder:replace_me@localhost:5432/homefinder
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_generated_secret_of_at_least_32_characters
SESSION_COOKIE_NAME=homefinder.sid
SESSION_TTL_HOURS=24
BCRYPT_COST=12
APP_ORIGIN=http://localhost:4200
# Empty disables proxy trust. Set trusted proxy addresses/CIDRs for deployment.
TRUST_PROXY=
# Resolved relative to backend when using npm scripts there. Persist this directory.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_PROPERTY_IMAGES=8
# Only test commands use this variable; must be a separate DB ending in _test.
TEST_DATABASE_URL=postgresql://homefinder_test:replace_me@localhost:5432/homefinder_test
# Optional, only consumed by the one-off admin:create command:
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
