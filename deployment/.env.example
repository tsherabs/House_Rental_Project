# Copy to deployment/.env. Generate two DIFFERENT random hex secrets (at least 32 bytes each).
# Hex avoids URL-encoding ambiguity in DATABASE_URL. Never commit deployment/.env.
POSTGRES_PASSWORD=
SESSION_SECRET=
# Local container preview. These must change together for public hosting.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:8080
CADDY_SITE=http://:80
BIND_HOST=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Public server example: NODE_ENV=production, APP_ORIGIN=https://your.domain,
# CADDY_SITE=your.domain, BIND_HOST=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443.
# DNS must resolve to that server; Caddy obtains TLS certificates automatically.
