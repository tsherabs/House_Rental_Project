{
  "name": "homefinder-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo:seed": "node --env-file-if-exists=../.env scripts/seed-demo.js",
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "db:migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "admin:create": "node --env-file-if-exists=../.env src/db/provision-admin.js",
    "test": "vitest run",
    "test:auth": "vitest run tests/auth.test.js tests/authorization.test.js tests/migrations.test.js",
    "lint": "eslint .",
    "check:api": "node scripts/check-api.js",
    "uploads:check": "node --env-file-if-exists=../.env src/db/check-uploads.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
